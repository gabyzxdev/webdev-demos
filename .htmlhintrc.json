{
  "extends": ["htmlhint:recommended"],
  "rules": {
    "tagname-lowercase": true,
    "attr-lowercase": true,
    "attr-value-double-quotes": true,
    "doctype-first": true,
    "spec-char-escape": true,
    "id-unique": true,
    "src-not-empty": true,
    "alt-require": true,
    "title-require": true,
    "doctype-html5": true,
    "id-class-value": "dash",
    "style-disabled": true,
    "inline-script-disabled": false,
    "inline-style-disabled": false
  },
  "ignore": ["curso-web/**", "linktree/**", "node_modules/**"]
}